// Fidra Island — Tangential Ear Flare Wings (Seamless Top-Notch Fillets)

export component EarFlares inherits Rectangle {
    in property <length> island-width: 290px;
    background: transparent;

    // Left Ear Flare Fill (#09090B matching island top)
    Path {
        x: 1px;
        y: 0px;
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        fill: #09090B;
        commands: "M 0 0 C 8 0 14 5 14 14 L 14 0 Z";
    }

    // Left Ear Flare Subtle Rim Stroke
    Path {
        x: 1px;
        y: 0px;
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        stroke: #222530;
        stroke-width: 1px;
        fill: transparent;
        commands: "M 0 0 C 8 0 14 5 14 14";
    }

    // Right Ear Flare Fill (#09090B matching island top)
    Path {
        x: root.island-width + 13px;
        y: 0px;
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        fill: #09090B;
        commands: "M 0 0 L 0 14 C 0 5 6 0 14 0 Z";
    }

    // Right Ear Flare Subtle Rim Stroke
    Path {
        x: root.island-width + 13px;
        y: 0px;
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        stroke: #222530;
        stroke-width: 1px;
        fill: transparent;
        commands: "M 0 14 C 0 5 6 0 14 0";
    }
}
