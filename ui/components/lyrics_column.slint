// Fidra Island — Scrolling Lyric Ribbon (Spotify / Apple Music style)
//
// ALL lyric lines live in one tall ribbon. When the active line changes, only
// `lyric-index` changes: the ribbon glides up by exactly one row while the old
// line shrinks/dims and the new line grows/brightens. No text is ever swapped,
// so there is no snap-back, ghosting or bounce. Background is fully transparent.

export component LyricsColumn inherits Rectangle {
    in property <bool> is-expanded: false;
    in property <bool> lyrics-enabled: false;
    in property <bool> is-playing: false;
    in property <string> track-title: "";
    in property <[string]> lyric-lines;
    in property <int> lyric-index: 0;
    in property <string> lyric-word-before: "";
    in property <string> lyric-word-current: "";
    in property <string> lyric-word-after: "";
    in property <bool> has-word-sync: false;
    in property <color> ambient-color: #38BDF8;

    callback seek-to-lyric(int);

    out property <bool> has-hover: touch.has-hover;

    private property <length> row-h: 32px;
    private property <duration> glide: 520ms;

    horizontal-stretch: 1;
    height: 100%;
    background: transparent;
    clip: true;
    opacity: (root.is-expanded && root.lyrics-enabled) ? 1.0 : 0.0;
    visible: self.opacity > 0.01;

    animate opacity {
        delay: root.is-expanded ? 130ms : 0ms;
        duration: root.is-expanded ? 340ms : 120ms;
        easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
    }

    // The ribbon: its y position keeps the active row vertically centered.
    ribbon := Rectangle {
        x: root.is-expanded ? 0px : 14px;
        y: (root.height - root.row-h) / 2 - root.lyric-index * root.row-h;
        width: root.width - 44px; // keep clear of the top-right buttons
        height: root.lyric-lines.length * root.row-h;
        background: transparent;

        animate x {
            delay: root.is-expanded ? 130ms : 0ms;
            duration: 380ms;
            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
        }

        // Smooth deceleration, no overshoot.
        animate y {
            duration: root.glide;
            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
        }

        for line[i] in root.lyric-lines: row := Rectangle {
            property <int> dist: Math.abs(i - root.lyric-index);
            property <bool> active: self.dist == 0;

            y: i * root.row-h;
            width: parent.width;
            height: root.row-h;
            background: transparent;

            // Fades with distance from the active line (far rows vanish => soft edges).
            opacity: self.dist == 0 ? 1.0 : (self.dist == 1 ? 0.4 : (self.dist == 2 ? 0.16 : 0.0));
            animate opacity {
                duration: root.glide;
                easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
            }

            // Plain line (GPU scale: active line grows, others shrink — smooth, no relayout).
            if !(self.active && root.has-word-sync): Text {
                x: 0px;
                width: parent.width;
                height: parent.height;
                text: line;
                color: #FFFFFF;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                transform-origin: { x: 0px, y: parent.height / 2 };
                transform-scale: parent.active ? 1.0 : 0.78;
                animate transform-scale {
                    duration: root.glide;
                    easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                }
            }

            // Word-by-word karaoke on the active line (when the LRC has word timing).
            if self.active && root.has-word-sync: HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0px;

                Text {
                    text: root.lyric-word-before;
                    color: #FFFFFFD9;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.lyric-word-current;
                    color: root.ambient-color;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.lyric-word-after;
                    color: #FFFFFF59;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Placeholder when no lyrics are loaded yet.
    if root.lyric-lines.length == 0: Text {
        x: 0px;
        width: root.width - 44px;
        height: root.height;
        text: root.is-playing ? root.track-title : "No Synced Lyrics";
        color: #FFFFFF59;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }

    // Click the line directly above/below the active one to seek to it.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // Rows above/below the vertical center map to -1 / +1.
            if (self.mouse-y < (root.height - root.row-h) / 2) {
                root.seek-to-lyric(-1);
            } else if (self.mouse-y > (root.height + root.row-h) / 2) {
                root.seek-to-lyric(1);
            }
        }
    }
}
