// Fidra Island — Scrolling Lyric Ribbon (Spotify / Apple Music style)
//
// ALL lyric lines live in one tall ribbon. When the active line changes, only
// `lyric-index` changes: the ribbon glides up by exactly one row while the old
// line shrinks/dims and the new line grows/brightens. No text is ever swapped,
// so there is no snap-back, ghosting or bounce. Background is fully transparent.
// Includes optional transliteration subtitle below CJK lyric lines.

import { LyricRow } from "types.slint";

export component LyricsColumn inherits Rectangle {
    in property <bool> is-expanded: false;
    in property <bool> lyrics-enabled: false;
    in property <bool> romanize-enabled: true;
    in property <bool> is-playing: false;
    in property <string> track-title: "";
    in property <[LyricRow]> lyric-lines;
    in property <int> lyric-index: 0;
    in property <string> lyric-word-before: "";
    in property <string> lyric-word-current: "";
    in property <string> lyric-word-after: "";
    in property <bool> has-word-sync: false;
    in property <color> ambient-color: #38BDF8;

    callback seek-to-lyric(int);

    out property <bool> has-hover: (root.is-expanded && root.lyrics-enabled) ? touch.has-hover : false;

    private property <length> row-h: root.romanize-enabled ? 48px : 34px;
    private property <duration> glide: 520ms;

    min-width: 0px;
    max-width: (root.is-expanded && root.lyrics-enabled) ? 100000px : 0px;
    horizontal-stretch: (root.is-expanded && root.lyrics-enabled) ? 1 : 0;
    height: 100%;
    background: transparent;
    clip: true;
    opacity: (root.is-expanded && root.lyrics-enabled) ? 1.0 : 0.0;
    visible: (root.is-expanded && root.lyrics-enabled);

    animate opacity {
        delay: root.is-expanded ? 130ms : 0ms;
        duration: root.is-expanded ? 340ms : 120ms;
        easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
    }

    // The ribbon: its y position keeps the active row vertically centered.
    ribbon := Rectangle {
        x: root.is-expanded ? 0px : 14px;
        y: (root.height - root.row-h) / 2 - root.lyric-index * root.row-h;
        width: root.width - 44px; // keep clear of the top-right buttons
        height: root.lyric-lines.length * root.row-h;
        background: transparent;

        animate x {
            delay: root.is-expanded ? 130ms : 0ms;
            duration: 380ms;
            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
        }

        // Smooth deceleration, no overshoot.
        animate y {
            duration: root.glide;
            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
        }

        for line[i] in root.lyric-lines: row := Rectangle {
            property <int> dist: Math.abs(i - root.lyric-index);
            property <bool> active: self.dist == 0;
            property <bool> show-sub: root.romanize-enabled && line.has_roman;

            y: i * root.row-h;
            width: parent.width;
            height: root.row-h;
            background: transparent;

            // Fades with distance from the active line (far rows vanish => soft edges).
            opacity: self.dist == 0 ? 1.0 : (self.dist == 1 ? 0.42 : (self.dist == 2 ? 0.16 : 0.0));
            animate opacity {
                duration: root.glide;
                easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
            }

            VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                spacing: row.show-sub ? 4px : 0px;

                // Main lyric text line
                Rectangle {
                    width: 100%;
                    height: row.show-sub ? (row.active ? 22px : 18px) : (row.active ? 24px : 20px);

                    if !(row.active && root.has-word-sync): Text {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: line.text;
                        color: #FFFFFF;
                        font-family: line.jp ? "LINE Seed JP" : "Plus Jakarta Sans";
                        font-size: row.show-sub ? (row.active ? 15px : 12px) : (row.active ? 16px : 12.5px);
                        font-weight: 700;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Word-by-word karaoke on the active line (when LRC has word timestamps)
                    if row.active && root.has-word-sync: HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;

                        Text {
                            text: root.lyric-word-before;
                            font-family: line.jp ? "LINE Seed JP" : "Plus Jakarta Sans";
                            color: #FFFFFFD9;
                            font-size: row.show-sub ? 15px : 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.lyric-word-current;
                            font-family: line.jp ? "LINE Seed JP" : "Plus Jakarta Sans";
                            color: root.ambient-color;
                            font-size: row.show-sub ? 15px : 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.lyric-word-after;
                            font-family: line.jp ? "LINE Seed JP" : "Plus Jakarta Sans";
                            color: #FFFFFF59;
                            font-size: row.show-sub ? 15px : 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Subtitle: Romanized Latin transliteration (Romaji/Pinyin/Hangul Latin)
                if row.show-sub: Text {
                    x: 0px;
                    width: parent.width;
                    height: row.active ? 15px : 13px;
                    text: line.roman;
                    color: row.active ? #CBD5E1 : #94A3B8;
                    font-family: "Plus Jakarta Sans";
                    font-size: row.active ? 11.5px : 10px;
                    font-weight: 500;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Placeholder when no lyrics are loaded yet.
    if root.lyric-lines.length == 0: Text {
        x: 0px;
        width: root.width - 44px;
        height: root.height;
        text: root.is-playing ? root.track-title : "No Synced Lyrics";
        color: #FFFFFF59;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }

    // Click the line directly above/below the active one to seek to it.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (self.mouse-y < (root.height - root.row-h) / 2) {
                root.seek-to-lyric(-1);
            } else if (self.mouse-y > (root.height + root.row-h) / 2) {
                root.seek-to-lyric(1);
            }
        }
    }
}
