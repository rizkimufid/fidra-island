// Fidra Island — 2-Column Adaptive Dynamic Island Layout & Motion Graphics

import { IconButton } from "components/controls.slint";
import { EarFlares } from "components/ear_flares.slint";
import { CompactLayer } from "components/compact_layer.slint";
import { PlayerColumn } from "components/player_column.slint";
import { LyricsColumn } from "components/lyrics_column.slint";
import { PrayerCard } from "components/prayer_card.slint";
import { PageSwitcher } from "components/page_switcher.slint";
import { TopToolbar } from "components/top_toolbar.slint";
import { LyricRow, PrayerRow } from "components/types.slint";

// Bundled typefaces (SIL OFL 1.1, see assets/fonts/OFL-*.txt).
import "../assets/fonts/PlusJakartaSans-Regular.ttf";
import "../assets/fonts/PlusJakartaSans-Bold.ttf";
import "../assets/fonts/LINESeedJP-Regular.ttf";
import "../assets/fonts/LINESeedJP-Bold.ttf";

export { LyricRow, PrayerRow }

export component MainWindow inherits Window {
    title: "Fidra Island";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Plus Jakarta Sans";

    width: 680px;
    height: 220px;

    in property <string> track-title: "No Media Playing";
    in property <string> artist-name: "Fidra Island";
    in property <string> album-name: "";
    in property <string> elapsed-time: "00:00";
    in property <string> duration-time: "00:00";
    in property <string> remaining-time: "—";
    in property <float> duration-seconds: 0;
    in property <bool> is-playing: false;
    in-out property <bool> is-expanded: false;
    in-out property <bool> is-pinned: false;
    in-out property <bool> lyrics-enabled: false;
    in-out property <bool> romanize-enabled: true;
    in-out property <bool> show-lyrics: false;
    in-out property <string> current-lyric-line: "";
    in-out property <[LyricRow]> lyric-lines;
    in-out property <int> lyric-index: 0;
    in-out property <string> lyric-word-before: "";
    in-out property <string> lyric-word-current: "";
    in-out property <string> lyric-word-after: "";
    in-out property <bool> has-word-sync: false;
    in-out property <string> current-time-str: "00:00";
    in-out property <float> battery-level: 1.0;
    in-out property <bool> is-charging: false;
    in-out property <string> battery-arc-path: "M 8 2 A 6 6 0 1 1 7.99 2 Z";
    in property <float> progress: 0.0;
    in property <image> album-art;
    in property <bool> has-album-art: false;
    in property <float> eq-bar1: 3.0;
    in property <float> eq-bar2: 3.0;
    in property <float> eq-bar3: 3.0;
    in property <float> eq-bar4: 3.0;
    in-out property <length> lyric-width: 310px;
    in-out property <bool> prayer-enabled: true;
    in-out property <string> prayer-name: "";
    in-out property <string> prayer-countdown: "";
    in-out property <bool> prayer-alert: false;
    in property <[PrayerRow]> prayer-schedule: [];
    in-out property <int> expanded-page: 0;

    // Dynamic adaptive ambient color extracted from current album art
    in property <color> ambient-color: #38BDF8;

    callback toggle-playback();
    callback skip-next();
    callback skip-previous();
    callback toggle-expanded();
    callback toggle-pinned();
    callback toggle-lyrics();
    callback toggle-romanize();
    callback page-changed(int);
    callback seek(float);
    callback seek-to-lyric(int);
    callback hover-changed(bool);

    out property <bool> is-mouse-inside:
        island-touch.has-hover
        || expanded-touch.has-hover
        || compact-comp.has-hover
        || player-comp.has-hover
        || lyrics-comp.has-hover
        || prayer-comp.has-hover
        || top-toolbar.has-hover
        || page-switcher.has-hover;

    changed is-mouse-inside => {
        root.hover-changed(self.is-mouse-inside);
    }

    in-out property <length> target-island-width: is-expanded
        ? ((expanded-page == 1 || lyrics-enabled) ? 610px : 320px)
        : (show-lyrics
        ? Math.clamp(lyric-width, 280px, 420px)
        : (compact-comp.has-hover ? 310px : 290px));

    in-out property <length> current-island-width: target-island-width;
    animate current-island-width {
        duration: is-expanded ? 420ms : 360ms;
        easing: is-expanded ? cubic-bezier(0.34, 1.35, 0.64, 1.0) : cubic-bezier(0.22, 1.0, 0.36, 1.0);
    }

    // ============================================================
    // UNIFIED NOTCH & WING WRAPPER
    // ============================================================
    island-wrapper := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: current-island-width + 28px;
        height: is-expanded ? 196px : 48px;
        background: transparent;

        // Main Obsidian Container (Solid #09090B top matching tangential ear flares)
        island := Rectangle {
            x: 14px;
            y: -12px;
            width: current-island-width;
            height: (is-expanded ? 184px : 38px) + 12px;
            border-bottom-left-radius: is-expanded ? 26px : 19px;
            border-bottom-right-radius: is-expanded ? 26px : 19px;
            background: @linear-gradient(180deg, #09090B 0%, #0E1015 100%);
            border-width: 1px;
            border-color: #262936;
            clip: true;

            animate height, border-bottom-left-radius, border-bottom-right-radius {
                duration: is-expanded ? 380ms : 320ms;
                easing: is-expanded ? cubic-bezier(0.34, 1.3, 0.64, 1.0) : cubic-bezier(0.22, 1.0, 0.36, 1.0);
            }

            // Dynamic Adaptive Ambient Glow (Soft diffuse wash across entire island background)
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                opacity: is-expanded ? (has-album-art ? 0.18 : 0.08) : 0.0;
                background: @radial-gradient(circle, root.ambient-color 0%, transparent 80%);
                animate opacity {
                    duration: 500ms;
                    easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                }
            }

            // Secondary localized soft glow behind the album art
            Rectangle {
                x: 10px;
                y: 10px;
                width: 140px;
                height: 140px;
                opacity: is-expanded ? (has-album-art ? 0.35 : 0.10) : 0.0;
                background: @radial-gradient(circle, root.ambient-color 0%, transparent 70%);
                animate opacity {
                    duration: 400ms;
                    easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                }
            }

            // 1px Specular Top Rim Highlight for physical glass realism
            Rectangle {
                x: 0;
                y: 12px;
                width: 100%;
                height: 1px;
                background: @linear-gradient(90deg, transparent 5%, #FFFFFF2E 30%, #FFFFFF40 50%, #FFFFFF2E 70%, transparent 95%);
            }

            island-touch := TouchArea {
                width: 100%;
                height: 100%;
                scroll-event(event) => {
                    if root.is-expanded {
                        if event.delta-y < 0px || event.delta-x < 0px {
                            root.expanded-page = 1;
                            root.page-changed(1);
                        } else if event.delta-y > 0px || event.delta-x > 0px {
                            root.expanded-page = 0;
                            root.page-changed(0);
                        }
                        return accept;
                    }
                    reject
                }
            }

            // ==========================================
            // COMPACT LAYER
            // ==========================================
            compact-layer := Rectangle {
                x: 0;
                y: 12px;
                width: parent.width;
                height: 38px;
                opacity: is-expanded ? 0.0 : 1.0;
                visible: self.opacity > 0.01;

                animate opacity {
                    duration: is-expanded ? 120ms : 260ms;
                    delay: is-expanded ? 0ms : 120ms;
                    easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                }

                compact-comp := CompactLayer {
                    is-expanded: root.is-expanded;
                    show-lyrics: root.show-lyrics;
                    track-title: root.track-title;
                    current-lyric-line: root.current-lyric-line;
                    current-time-str: root.current-time-str;
                    battery-level: root.battery-level;
                    is-charging: root.is-charging;
                    battery-arc-path: root.battery-arc-path;
                    is-playing: root.is-playing;
                    eq-bar1: root.eq-bar1;
                    eq-bar2: root.eq-bar2;
                    eq-bar3: root.eq-bar3;
                    eq-bar4: root.eq-bar4;
                    prayer-enabled: root.prayer-enabled;
                    prayer-name: root.prayer-name;
                    prayer-countdown: root.prayer-countdown;
                    prayer-alert: root.prayer-alert;
                    toggle-expanded => { root.toggle-expanded(); }
                }
            }

            // ==========================================
            // ==========================================
            // EXPANDED LAYER (Carousel: Page 0 = Music/Lyrics, Page 1 = Jadwal Sholat)
            // ==========================================
            expanded-layer := Rectangle {
                x: 0;
                y: 12px;
                width: parent.width;
                height: 184px;
                opacity: is-expanded ? 1.0 : 0.0;
                visible: self.opacity > 0.01;

                animate opacity {
                    duration: is-expanded ? 240ms : 120ms;
                    easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                }

                // Base touch area covering full expanded surface (handles background hover & scroll)
                expanded-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    scroll-event(event) => {
                        if event.delta-y < 0px || event.delta-x < 0px {
                            root.expanded-page = 1;
                            root.page-changed(1);
                        } else if event.delta-y > 0px || event.delta-x > 0px {
                            root.expanded-page = 0;
                            root.page-changed(0);
                        }
                        accept
                    }
                }

                // Unified Top Bar: Left = Island Branding, Right = Action Toolbar
                HorizontalLayout {
                    x: 16px;
                    y: 7px;
                    width: parent.width - 32px;
                    height: 24px;
                    alignment: space-between;

                    // Left Branding Pill
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            background: root.expanded-page == 1 ? #10B981 : (root.is-playing ? #1ED760 : #38BDF8);
                            animate background { duration: 250ms; }
                        }

                        Text {
                            visible: root.expanded-page == 1 || root.lyrics-enabled;
                            min-width: 0px;
                            max-width: (root.expanded-page == 1 || root.lyrics-enabled) ? 120px : 0px;
                            overflow: elide;
                            text: root.expanded-page == 1 ? "JADWAL SHOLAT" : "FIDRA ISLAND";
                            font-size: 10px;
                            font-weight: 800;
                            color: #64748B;
                            letter-spacing: 0.8px;
                            vertical-alignment: center;
                        }
                    }

                    // Right: Quick Action Toolbar
                    top-toolbar := TopToolbar {
                        y: (parent.height - self.height) / 2;
                        active-page: root.expanded-page;
                        lyrics-enabled: root.lyrics-enabled;
                        romanize-enabled: root.romanize-enabled;
                        is-pinned: root.is-pinned;
                        toggle-lyrics => { root.toggle-lyrics(); }
                        toggle-romanize => { root.toggle-romanize(); }
                        toggle-pinned => { root.toggle-pinned(); }
                        toggle-expanded => { root.toggle-expanded(); }
                    }
                }

                // Content Viewport: Clean, spacious, zero-collision
                content-viewport := Rectangle {
                    x: 20px;
                    y: 34px;
                    width: parent.width - 40px;
                    height: 128px;
                    clip: true;

                    // Page 0: Music Player & Synced Lyrics
                    page0 := Rectangle {
                        x: root.expanded-page == 0 ? 0px : -parent.width - 24px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        opacity: root.expanded-page == 0 ? 1.0 : 0.0;
                        visible: self.opacity > 0.01;

                        animate opacity {
                            duration: 320ms;
                            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                        }
                        animate x {
                            duration: 380ms;
                            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                        }

                        HorizontalLayout {
                            spacing: root.lyrics-enabled ? 24px : 0px;
                            alignment: root.lyrics-enabled ? stretch : center;

                            player-comp := PlayerColumn {
                                is-expanded: root.is-expanded;
                                is-playing: root.is-playing;
                                track-title: root.track-title;
                                artist-name: root.artist-name;
                                album-name: root.album-name;
                                elapsed-time: root.elapsed-time;
                                remaining-time: root.remaining-time;
                                progress: root.progress;
                                album-art: root.album-art;
                                has-album-art: root.has-album-art;
                                ambient-color: root.ambient-color;
                                toggle-playback => { root.toggle-playback(); }
                                skip-next => { root.skip-next(); }
                                skip-previous => { root.skip-previous(); }
                                seek(val) => { root.seek(val); }
                            }

                            lyrics-comp := LyricsColumn {
                                min-width: 0px;
                                max-width: root.lyrics-enabled ? 100000px : 0px;
                                is-expanded: root.is-expanded;
                                lyrics-enabled: root.lyrics-enabled;
                                romanize-enabled: root.romanize-enabled;
                                is-playing: root.is-playing;
                                track-title: root.track-title;
                                lyric-lines: root.lyric-lines;
                                lyric-index: root.lyric-index;
                                lyric-word-before: root.lyric-word-before;
                                lyric-word-current: root.lyric-word-current;
                                lyric-word-after: root.lyric-word-after;
                                has-word-sync: root.has-word-sync;
                                ambient-color: root.ambient-color;
                                seek-to-lyric(dir) => { root.seek-to-lyric(dir); }
                            }
                        }
                    }

                    // Page 1: Jadwal Sholat Hub
                    page1 := Rectangle {
                        x: root.expanded-page == 1 ? 0px : parent.width + 24px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        opacity: root.expanded-page == 1 ? 1.0 : 0.0;
                        visible: self.opacity > 0.01;

                        animate opacity {
                            duration: 320ms;
                            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                        }
                        animate x {
                            duration: 380ms;
                            easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                        }

                        prayer-comp := PrayerCard {
                            width: 100%;
                            height: 100%;
                            prayer-name: root.prayer-name;
                            prayer-countdown: root.prayer-countdown;
                            prayer-alert: root.prayer-alert;
                            schedule: root.prayer-schedule;
                            scroll-page(page) => {
                                root.expanded-page = page;
                                root.page-changed(page);
                            }
                        }
                    }
                }

                // Bottom Floating Page Indicator & Interactive Capsule
                page-switcher := PageSwitcher {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 4px;
                    active-page: root.expanded-page;
                    set-page(page) => {
                        root.expanded-page = page;
                        root.page-changed(page);
                    }
                }
            }
        }

        // Tangential Ear Flares for smooth screen-top continuity
        EarFlares {
            island-width: root.current-island-width;
        }
    }
}
