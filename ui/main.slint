// Fidra Music Island - Strict Motion & Morphing Architecture

component BatteryRing inherits Rectangle {
    in property <string> arc-path;
    in property <bool> is-charging: false;
    in property <float> progress: 0.85;
    width: 16px;
    height: 16px;
    background: transparent;

    // Track circle
    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        viewbox-x: 0;
        viewbox-y: 0;
        stroke: #252A3C;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 8 2 A 6 6 0 1 1 7.99 2 Z";
    }

    // Active progress arc
    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        viewbox-x: 0;
        viewbox-y: 0;
        stroke: is-charging ? #22C55E : (progress < 0.2 ? #EF4444 : (progress < 0.45 ? #F59E0B : #38BDF8));
        stroke-width: 2px;
        fill: transparent;
        commands: arc-path;
    }

    if is-charging : Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        source: @image-url("../assets/icons/zap.svg");
        colorize: #22C55E;
        image-fit: contain;
    }
}

component EqualizerMini inherits Rectangle {
    in property <bool> is-playing: false;
    in property <color> bar-color: #FF7456;
    in property <float> bar1: 3.0;
    in property <float> bar2: 3.0;
    in property <float> bar3: 3.0;
    in property <float> bar4: 3.0;
    width: 14px;
    height: 12px;
    background: transparent;

    HorizontalLayout {
        spacing: 2px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 2px;
                height: (is-playing ? bar1 : 3.0) * 1px;
                border-radius: 1px;
                background: bar-color;
                animate height { duration: 90ms; easing: ease-in-out; }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 2px;
                height: (is-playing ? bar2 : 3.0) * 1px;
                border-radius: 1px;
                background: bar-color;
                animate height { duration: 90ms; easing: ease-in-out; }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 2px;
                height: (is-playing ? bar3 : 3.0) * 1px;
                border-radius: 1px;
                background: bar-color;
                animate height { duration: 90ms; easing: ease-in-out; }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 2px;
                height: (is-playing ? bar4 : 3.0) * 1px;
                border-radius: 1px;
                background: bar-color;
                animate height { duration: 90ms; easing: ease-in-out; }
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <length> button-size: 28px;
    in property <length> icon-size: 13px;
    in property <color> icon-color: #D6DAE4;
    in property <color> bg-color: #161925;
    in property <color> hover-bg: #272C3D;
    in property <color> border-col: #293043;
    in property <length> radius: 8px;
    out property <bool> pressed <=> touch.pressed;
    out property <bool> has-hover <=> touch.has-hover;
    callback clicked();

    width: touch.pressed ? button-size - 2px : button-size;
    height: touch.pressed ? button-size - 2px : button-size;
    border-radius: radius;
    background: touch.has-hover ? hover-bg : bg-color;
    border-width: 1px;
    border-color: touch.has-hover ? #4C5675 : border-col;
    animate width, height { duration: 100ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: icon-size;
        height: icon-size;
        source: icon-source;
        colorize: icon-color;
        image-fit: contain;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PlayPauseButton inherits Rectangle {
    in property <bool> is-playing: false;
    in property <length> button-size: 36px;
    out property <bool> pressed <=> touch.pressed;
    out property <bool> has-hover <=> touch.has-hover;
    callback clicked();

    width: touch.pressed ? button-size - 3px : button-size;
    height: touch.pressed ? button-size - 3px : button-size;
    border-radius: self.height / 2;
    background: touch.pressed
        ? #E64E2E
        : (touch.has-hover ? #FF856B : #FF5D3B);
    drop-shadow-blur: touch.has-hover ? 12px : 6px;
    drop-shadow-color: #FF5D3B66;
    drop-shadow-offset-y: 2px;
    animate width, height { duration: 120ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
    animate background, drop-shadow-blur { duration: 140ms; }

    Image {
        x: (parent.width - self.width) / 2 + (is-playing ? 0px : 1px);
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: is-playing
            ? @image-url("../assets/icons/pause.svg")
            : @image-url("../assets/icons/play.svg");
        colorize: #FFFFFF;
        image-fit: contain;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Fidra Music Island";
    no-frame: true;
    always-on-top: is-pinned;
    background: transparent;
    default-font-family: "Segoe UI";

    width: 480px;
    height: 410px;

    in property <string> track-title: "Not Playing";
    in property <string> artist-name: "Fidra Music";
    in property <string> album-name: "";
    in property <string> elapsed-time: "02:14";
    in property <string> duration-time: "04:02";
    in property <float> duration-seconds: 242;
    in property <bool> is-playing: false;
    in-out property <bool> is-expanded: false;
    in-out property <bool> is-pinned: false;
    in-out property <bool> lyrics-active: false;
    in-out property <bool> show-lyrics: false;
    in-out property <string> current-lyric-line: "";
    in-out property <string> current-time-str: "12:00";
    in-out property <float> battery-level: 1.0;
    in-out property <bool> is-charging: false;
    in-out property <string> battery-arc-path: "M 8 2 A 6 6 0 1 1 7.99 2 Z";
    in property <float> progress: 0.55;
    in-out property <float> volume: 0.72;
    in property <image> album-art;
    in property <bool> has-album-art: false;
    in property <float> eq-bar1: 3.0;
    in property <float> eq-bar2: 3.0;
    in property <float> eq-bar3: 3.0;
    in property <float> eq-bar4: 3.0;
    in-out property <length> lyric-width: 320px;

    callback toggle-playback();
    callback skip-next();
    callback skip-previous();
    callback toggle-expanded();
    callback toggle-pinned();
    callback toggle-lyrics();
    callback seek(float);
    callback change-volume(float);
    callback hover-changed(bool);

    // Composite hover detection covering all interactive elements & background
    out property <bool> is-mouse-inside:
        island-touch.has-hover
        || compact-touch.has-hover
        || lyric-btn.has-hover
        || pin-btn.has-hover
        || collapse-btn.has-hover
        || prev-btn.has-hover
        || play-btn.has-hover
        || next-btn.has-hover
        || seek-touch.has-hover
        || vol-touch.has-hover;

    changed is-mouse-inside => {
        root.hover-changed(self.is-mouse-inside);
    }

    // Dynamic width target: adapts to compact contents (184px default, dynamic lyric-width for lyrics, 384px for compact expanded)
    in-out property <length> target-island-width: is-expanded
        ? 384px
        : (show-lyrics
            ? (compact-touch.has-hover ? lyric-width + 16px : lyric-width)
            : (compact-touch.has-hover ? 200px : 184px));
    in-out property <length> current-island-width: target-island-width;
    animate current-island-width {
        duration: 420ms;
        easing: cubic-bezier(0.34, 1.45, 0.64, 1.0);
    }

    // ============================================================
    // UNIFIED NOTCH & WING WRAPPER (100% Zero-Lag Synchronization)
    // ============================================================
    island-wrapper := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: current-island-width + 14px;
        height: is-expanded ? 176px : 46px;
        background: transparent;

        // Single unified morphing island container
        island := Rectangle {
            x: 7px;
            y: -10px;
            width: current-island-width;
            height: (is-expanded ? 176px : 36px) + 10px;
            border-bottom-left-radius: is-expanded ? 20px : 16px;
            border-bottom-right-radius: is-expanded ? 20px : 16px;
            // Rich amber-obsidian luxury gradient with subtle glowing horizon
            background: @linear-gradient(180deg, #1C1613 0%, #10121A 45%, #0B0C12 100%);
            border-width: 1px;
            border-color: #352B26;
            // Clean, restrained elevation shadow without heavy smudge
            drop-shadow-blur: is-expanded ? 14px : 6px;
            drop-shadow-offset-y: is-expanded ? 4px : 2px;
            drop-shadow-color: #00000040;
            clip: true;

            animate height, border-bottom-left-radius, border-bottom-right-radius, drop-shadow-blur, drop-shadow-offset-y {
                duration: 400ms;
                easing: is-expanded ? cubic-bezier(0.34, 1.45, 0.64, 1.0) : cubic-bezier(0.22, 1.0, 0.36, 1.0);
            }

            // Background touch area covering full island
            island-touch := TouchArea {
                width: 100%;
                height: 100%;
            }

            // ==========================================
            // COMPACT LAYER (Lives inside island, fades out on expand)
            // ==========================================
            compact-layer := Rectangle {
                x: 0;
                y: 10px;
                width: parent.width;
                height: 36px;
                opacity: is-expanded ? 0.0 : 1.0;
                visible: self.opacity > 0.01;

                animate opacity {
                    duration: is-expanded ? 140ms : 240ms;
                    easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                }

                compact-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-expanded();
                    }
                }

                // State 1: Default Compact (Jam & Batre Circle Bar with High-Tech Chips & Live Equalizer)
                if !show-lyrics : VerticalLayout {
                    alignment: center;
                    width: 100%;
                    height: 100%;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        // Time Widget Pill Chip
                        Rectangle {
                            height: 24px;
                            border-radius: 12px;
                            background: #141724;
                            border-width: 1px;
                            border-color: #272F44;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;

                                // Mini glowing amber clock dot
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 5px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: #FF7456;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: #FF745688;
                                    }
                                }

                                Text {
                                    text: current-time-str;
                                    color: #F1F3F9;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Center Ambient Equalizer (gives alive music-island identity)
                        VerticalLayout {
                            alignment: center;
                            EqualizerMini {
                                is-playing: is-playing;
                                bar-color: is-playing ? #FF7456 : #444C66;
                                bar1: root.eq-bar1;
                                bar2: root.eq-bar2;
                                bar3: root.eq-bar3;
                                bar4: root.eq-bar4;
                            }
                        }

                        // Battery Widget Pill Chip
                        Rectangle {
                            height: 24px;
                            border-radius: 12px;
                            background: #141724;
                            border-width: 1px;
                            border-color: #272F44;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: Math.round(Math.clamp(battery-level, 0.0, 1.0) * 100) + "%";
                                    color: is-charging ? #4ADE80 : (battery-level < 0.2 ? #F87171 : #D6DCEE);
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.3px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    BatteryRing {
                                        progress: battery-level;
                                        is-charging: is-charging;
                                        arc-path: battery-arc-path;
                                    }
                                }
                            }
                        }
                    }
                }

                // State 2: Lyrics Mode (Music Icon Badge + Synced Lyric Line + Dynamic Equalizer)
                if show-lyrics : VerticalLayout {
                    alignment: center;
                    width: 100%;
                    height: 100%;

                    HorizontalLayout {
                        alignment: center;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        // Music Lucide Icon Badge (strictly Lucide music.svg, NOT album art)
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                background: #241A18;
                                border-width: 1px;
                                border-color: #4C2D24;

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../assets/icons/music.svg");
                                    colorize: #FF7456;
                                    image-fit: contain;
                                }
                            }
                        }

                        // Synced Lyric Line
                        Text {
                            text: current-lyric-line != "" ? current-lyric-line : track-title;
                            color: #F8FAFC;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        // Dynamic Mini Equalizer
                        VerticalLayout {
                            alignment: center;
                            EqualizerMini {
                                is-playing: is-playing;
                                bar-color: #FF7456;
                                bar1: root.eq-bar1;
                                bar2: root.eq-bar2;
                                bar3: root.eq-bar3;
                                bar4: root.eq-bar4;
                            }
                        }
                    }
                }
            }

            // ==========================================
            // EXPANDED LAYER (macOS-Style Compact Minimalist Surface)
            // ==========================================
            expanded-layer := Rectangle {
                x: 0;
                y: 10px;
                width: parent.width;
                height: parent.height - 10px;
                opacity: is-expanded ? 1.0 : 0.0;
                visible: self.opacity > 0.01;

                animate opacity {
                    duration: is-expanded ? 240ms : 120ms;
                    easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                }

                // Row 1: Header Section (y: 6px, height: 22px)
                header-section := HorizontalLayout {
                    x: 16px;
                    y: is-expanded ? 6px : 14px;
                    width: parent.width - 32px;
                    height: 22px;
                    spacing: 6px;
                    alignment: center;

                    animate y {
                        duration: is-expanded ? 240ms : 120ms;
                        easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                    }

                    // Now Playing Badge
                    Rectangle {
                        height: 20px;
                        border-radius: 10px;
                        background: #141724;
                        border-width: 1px;
                        border-color: #272F44;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: is-playing ? #22C55E : #717687;
                                }
                            }

                            Text {
                                text: is-playing ? "NOW PLAYING" : "WINDOWS MEDIA";
                                color: is-playing ? #4ADE80 : #9BA5BC;
                                font-size: 9px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Explicit Lyrics Toggle Button (Lucide Lyrics Icon)
                    lyric-btn := IconButton {
                        button-size: 22px;
                        icon-size: 13px;
                        icon-source: @image-url("../assets/icons/lyrics.svg");
                        icon-color: lyrics-active ? #FF7456 : #9BA5BC;
                        bg-color: lyrics-active ? #2A1F24 : #141724;
                        border-col: lyrics-active ? #FF745688 : #272F44;
                        radius: 6px;
                        clicked => { root.toggle-lyrics(); }
                    }

                    // Pin Lucide Button
                    pin-btn := IconButton {
                        button-size: 22px;
                        icon-size: 12px;
                        icon-source: @image-url("../assets/icons/pin.svg");
                        icon-color: is-pinned ? #FF7456 : #9BA5BC;
                        bg-color: is-pinned ? #2A1F24 : #141724;
                        border-col: is-pinned ? #FF745688 : #272F44;
                        radius: 6px;
                        clicked => { root.toggle-pinned(); }
                    }

                    // Collapse Lucide Button (Chevron Up)
                    collapse-btn := IconButton {
                        button-size: 22px;
                        icon-size: 11px;
                        icon-source: @image-url("../assets/icons/chevron-up.svg");
                        bg-color: #141724;
                        border-col: #272F44;
                        radius: 6px;
                        clicked => { root.toggle-expanded(); }
                    }
                }

                // Row 2: Hero Track Info (y: 34px, height: 48px)
                hero-section := HorizontalLayout {
                    x: 16px;
                    y: is-expanded ? 34px : 42px;
                    width: parent.width - 32px;
                    height: 48px;
                    spacing: 12px;
                    alignment: center;

                    animate y {
                        duration: is-expanded ? 260ms : 120ms;
                        easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                    }

                    // Album Art with subtle Live Equalizer badge
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 9px;
                        background: #1A1E2C;
                        border-width: 1px;
                        border-color: #2D354B;
                        clip: true;

                        if has-album-art : Image {
                            source: album-art;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                        if !has-album-art : Image {
                            source: @image-url("../assets/icons/music.svg");
                            width: 22px;
                            height: 22px;
                            colorize: #717687;
                            image-fit: contain;
                        }

                        // Subtle animated overlay badge on album art when playing
                        if is-playing : Rectangle {
                            x: parent.width - self.width - 3px;
                            y: parent.height - self.height - 3px;
                            width: 18px;
                            height: 14px;
                            border-radius: 4px;
                            background: #000000B0;

                            EqualizerMini {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                is-playing: true;
                                bar-color: #FF7456;
                                bar1: root.eq-bar1;
                                bar2: root.eq-bar2;
                                bar3: root.eq-bar3;
                                bar4: root.eq-bar4;
                            }
                        }
                    }

                    // Title & Artist with generous breathing space
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: track-title;
                            color: #F4F4F6;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: artist-name + (album-name != "" ? " · " + album-name : "");
                            color: #9BA5BC;
                            font-size: 11px;
                            font-weight: 500;
                            overflow: elide;
                        }
                    }
                }

                // Row 3: Scrubber Track & Timestamps (y: 90px, height: 24px)
                scrubber-section := VerticalLayout {
                    x: 16px;
                    y: is-expanded ? 90px : 98px;
                    width: parent.width - 32px;
                    height: 24px;
                    spacing: 4px;

                    animate y {
                        duration: is-expanded ? 280ms : 120ms;
                        easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                    }

                    // Progress Track
                    Rectangle {
                        height: seek-touch.has-hover ? 6px : 4px;
                        border-radius: self.height / 2;
                        background: #252A3C;
                        animate height { duration: 140ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }

                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp(progress, 0.0, 1.0);
                            height: parent.height;
                            border-radius: parent.height / 2;
                            background: @linear-gradient(90deg, #FF5D3B 0%, #FF856B 100%);
                        }

                        seek-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.seek(self.mouse-x / self.width); }
                        }
                    }

                    // Timestamps
                    HorizontalLayout {
                        Text { text: elapsed-time; color: #717687; font-size: 10px; font-weight: 500; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: duration-time; color: #717687; font-size: 10px; font-weight: 500; }
                    }
                }

                // Row 4: Volume & Playback Controls (y: 122px, height: 38px) - 100% Mathematically Centered
                controls-section := HorizontalLayout {
                    x: 16px;
                    y: is-expanded ? 122px : 130px;
                    width: parent.width - 32px;
                    height: 38px;
                    alignment: center;

                    animate y {
                        duration: is-expanded ? 300ms : 120ms;
                        easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);
                    }

                    // Volume Deck (Left) - Perfectly Centered
                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 14px;
                                    height: 14px;
                                    colorize: #9BA5BC;
                                    image-fit: contain;
                                    source: volume > 0.5
                                        ? @image-url("../assets/icons/volume-2.svg")
                                        : (volume > 0.01
                                            ? @image-url("../assets/icons/volume-1.svg")
                                            : @image-url("../assets/icons/volume-x.svg"));
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 72px;
                                    height: vol-touch.has-hover ? 6px : 4px;
                                    border-radius: self.height / 2;
                                    background: #252A3C;
                                    animate height { duration: 140ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }

                                    Rectangle {
                                        x: 0;
                                        width: parent.width * Math.clamp(volume, 0.0, 1.0);
                                        height: parent.height;
                                        border-radius: parent.height / 2;
                                        background: @linear-gradient(90deg, #6366F1 0%, #818CF8 100%);
                                    }

                                    vol-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.change-volume(self.mouse-x / self.width); }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: Math.round(Math.clamp(volume, 0.0, 1.0) * 100) + "%";
                                    color: #717687;
                                    font-size: 10px;
                                    font-weight: 500;
                                    width: 26px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Transport Buttons (Right) - Perfectly Centered
                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                prev-btn := IconButton {
                                    button-size: 30px;
                                    icon-size: 13px;
                                    icon-source: @image-url("../assets/icons/skip-back.svg");
                                    radius: 15px;
                                    clicked => { root.skip-previous(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                play-btn := PlayPauseButton {
                                    is-playing: is-playing;
                                    button-size: 36px;
                                    clicked => { root.toggle-playback(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                next-btn := IconButton {
                                    button-size: 30px;
                                    icon-size: 13px;
                                    icon-source: @image-url("../assets/icons/skip-forward.svg");
                                    radius: 15px;
                                    clicked => { root.skip-next(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ============================================================
        // SUBTLE, SEAMLESS INVERTED ROUNDED FILLETS (7px Micro-Radius)
        // Perfectly blends the notch into top screen bezel without giant horns
        // ============================================================

        // Left Subtle Fillet (7px x 7px + 1px overlap)
        Rectangle {
            x: 0px;
            y: 0px;
            width: 8px;
            height: 7px;
            background: transparent;

            // Fill masking over island top-left border
            Path {
                width: 8px;
                height: 7px;
                viewbox-width: 8;
                viewbox-height: 7;
                viewbox-x: 0;
                viewbox-y: 0;
                fill: #1C1613;
                commands: "M 0 0 C 4 0 7 3 7 7 L 8 7 L 8 0 Z";
            }

            // Smooth 1px outer contour stroke
            Path {
                width: 8px;
                height: 7px;
                viewbox-width: 8;
                viewbox-height: 7;
                viewbox-x: 0;
                viewbox-y: 0;
                stroke: #352B26;
                stroke-width: 1px;
                fill: transparent;
                commands: "M 0 0 C 4 0 7 3 7 7";
            }
        }

        // Right Subtle Fillet (7px x 7px + 1px overlap)
        Rectangle {
            x: current-island-width + 6px;
            y: 0px;
            width: 8px;
            height: 7px;
            background: transparent;

            // Fill masking over island top-right border
            Path {
                width: 8px;
                height: 7px;
                viewbox-width: 8;
                viewbox-height: 7;
                viewbox-x: 0;
                viewbox-y: 0;
                fill: #1C1613;
                commands: "M 0 0 L 0 7 L 1 7 C 1 3 4 0 8 0 Z";
            }

            // Smooth 1px outer contour stroke
            Path {
                width: 8px;
                height: 7px;
                viewbox-width: 8;
                viewbox-height: 7;
                viewbox-x: 0;
                viewbox-y: 0;
                stroke: #352B26;
                stroke-width: 1px;
                fill: transparent;
                commands: "M 1 7 C 1 3 4 0 8 0";
            }
        }
    }
}
